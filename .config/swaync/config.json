{
	"$schema": "/etc/xdg/swaync/configSchema.json",
	"ignore-gtk-theme": true,
	"positionX": "right",
	"positionY": "top",
	"control-center-positionX": "right",
	"layer": "overlay",
	"control-center-layer": "overlay",
	"layer-shell": true,
	"layer-shell-cover-screen": true,
	"cssPriority": "highest",
	"control-center-margin-top": 14,
	"control-center-margin-bottom": 14,
	"control-center-margin-right": 14,
	"control-center-margin-left": 0,
	"notification-2fa-action": true,
	"notification-inline-replies": false,
	"notification-body-image-height": 150,
	"notification-body-image-width": 300,
	"notification-window-width": 600,
	"notification-window-height": 1440,
	"notification-window-preferred-output": "DP-1",
	"control-center-preferred-output": "DP-1",
	"timeout": 5,
	"timeout-low": 5,
	"timeout-critical": 5,
	"fit-to-screen": true,
	"relative-timestamps": true,
	"control-center-width": 700,
	"control-center-height": 600,
	"keyboard-shortcuts": false,
	"notification-grouping": true,
	"image-visibility": "when-available",
	"transition-time": 200,
	"hide-on-clear": false,
	"hide-on-action": true,
	"text-empty": "No Notifications",
	"script-fail-notify": true,
	"scripts": {
		"Sound": {
			"exec": "sh -c '$HOME/.config/swaync/scripts/notification.sh'",
			"urgency": "Normal"
		},
		"sound2": {
			"exec": "sh -c 'pw-cat -p $HOME/.config/swaync/se_elevator_ding.ogg'",
			"app-name": "^sway-script$",
			"urgency": "Critical"
		}
	},
	"notification-visibility": {
		"example-name": {
			"state": "muted",
			"urgency": "Low",
			"app-name": "Spotify"
		},
		"sound2": {
			"app-name": "^sway-script$",
			"override-urgency": "Critical"
		}
	},
	"widgets": [
		"dnd",
		"title",
		"notifications",
		"mpris"
	],
	"widget-config": {
		"notifications": {
			"vexpand": true
		},
		"inhibitors": {
			"text": "Inhibitors",
			"button-text": "Clear All",
			"clear-all-button": true
		},
		"title": {
			"text": "Notifications",
			"clear-all-button": true,
			"button-text": "Clear All"
		},
		"dnd": {
			"text": "Do Not Disturb"
		},
		"label": {
			"max-lines": 5,
			"text": "Label Text"
		},
		"mpris": {
			"blacklist": [],
			"autohide": false,
			"show-album-art": "always",
			"loop-carousel": false
		},
		"buttons-grid": {
			"buttons-per-row": 7,
			"actions": [
				{
					"label": "直",
					"type": "toggle",
					"active": true,
					"command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
					"update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
				}
			]
		}
	}
}
